# 复制本文件为 .env 并按需修改
# 启用 MySQL（设为 false 或不设则使用文件 messages.json 存储）
USE_MYSQL=true

# MySQL 连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=chat_db

# 服务端口
PORT=3000
HOST=0.0.0.0

# Cloudflare R2 对象存储(可选,不配置则上传文件存到本地 uploads/ 目录)
# 配置步骤:
# 1. Cloudflare 仪表盘 → R2 → 创建 bucket(如 chat-uploads)
# 2. R2 → 管理 R2 API 令牌 → 创建 API 令牌(获取 Access Key ID 和 Secret Access Key)
# 3. R2 → bucket → 设置 → 自定义域 → 绑定一个域名(如 img.chat.torasu.xyz)
#    或用 r2.dev 子域名(仅测试用,有速率限制)
# R2_ACCOUNT_ID=你的账户ID(仪表盘右侧可以看到)
# R2_ACCESS_KEY_ID=你的Access Key ID
# R2_SECRET_ACCESS_KEY=你的Secret Access Key
# R2_BUCKET_NAME=chat-uploads
# R2_PUBLIC_URL=https://img.chat.torasu.xyz
